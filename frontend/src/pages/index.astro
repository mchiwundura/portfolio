---
import BaseHead from '../components/BaseHead.astro';
import { getCollection } from 'astro:content';
import FundekaMockup from '../assets/fundeka_mock.png';
import ProfileReveal from '../components/Profilereveal.astro';
import { Image } from 'astro:assets';
import ZimbabweADR from '../assets/zimbabwe_adr.svg';
import PharmacokineticPAR from '../assets/pharmacokinetic_par.svg'; 
import Header from '../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/design.css';

const projects = (await getCollection('projects'));
---
<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { SplitText } from "gsap/SplitText";
gsap.registerPlugin(ScrollTrigger, SplitText);
const hero = document.getElementById("hero");

gsap.to(hero, {
  scale: 0.4,          // 1 - 0.6
  ease: "none",
  scrollTrigger: {
    trigger: hero,
    start: "top top",
    end: "50% top",    // same as window.innerHeight * 0.5
    scrub: 0.8
  }
});

  // Split the text
  let split = SplitText.create(".about-content", {type:"words,lines"});

  // Animate each line (we can use each sentence as a line)
  gsap.from(split.lines, {
    y: 50,
    opacity: 0,
    duration: 0.8,
    ease: "power3.out",
    stagger: 0.3,
    scrollTrigger: {
      trigger: "#about",
      start: "top 80%",
      toggleActions: "play none none none"
    }
  });

  // Optional: refresh on resize
  window.addEventListener("resize", () => split.revert());

// the skills section
document.addEventListener("DOMContentLoaded", () => {
  const categories = document.querySelectorAll(".skill-category");

  categories.forEach((cat) => {
    const content = cat.querySelector(".skill-content");
    const icon = cat.querySelector(".icon");

    // Initial state
    if (cat.classList.contains("active")) {
      gsap.set(content, { height: "auto" });
      gsap.set(icon, { rotate: 45 });
    } else {
      gsap.set(content, { height: 0 });
    }

    cat.addEventListener("click", () => {
      const isActive = cat.classList.contains("active");

      // Close all
      categories.forEach((c) => {
        c.classList.remove("active");

        gsap.to(c.querySelector(".skill-content"), {
          height: 0,
          duration: 0.4,
          ease: "power2.inOut"
        });

        gsap.to(c.querySelector(".icon"), {
          rotate: 0,
          duration: 0.3
        });
      });

      // Open clicked
      if (!isActive) {
        cat.classList.add("active");

        gsap.to(content, {
          height: "auto",
          duration: 0.5,
          ease: "power3.out"
        });

        gsap.from(content.children, {
          opacity: 0,
          y: 20,
          stagger: 0.1,
          duration: 0.4
        });

        gsap.to(icon, {
          rotate: 45,
          duration: 0.3
        });
      }
    });
  });
});
</script>

