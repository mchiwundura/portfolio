---
import BaseHead from '../components/BaseHead.astro';
import { getCollection } from 'astro:content';
import FundekaMockup from '../assets/fundeka_mock.png';
import ProfileReveal from '../components/Profilereveal.astro';
import { getImage, Image } from 'astro:assets';
import ZimbabweADR from '../assets/zimbabwe_adr.svg';
import PharmacokineticPAR from '../assets/pharmacokinetic_par.svg'; 
import Header from '../components/Header.astro'
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/design.css';

const projects = (await getCollection('projects'));

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const writingPosts = await Promise.all(
	latestPosts.map(async (post) => ({
		href: `/blog/${post.id}/`,
		title: post.data.title,
		pubDate: post.data.pubDate,
		heroUrl: post.data.heroImage
			? (
					await getImage({
						src: post.data.heroImage,
						width: 720,
						height: 480,
						fit: 'cover',
						format: 'webp',
					})
				).src
			: null,
	})),
);
---
<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { SplitText } from "gsap/SplitText";
gsap.registerPlugin(ScrollTrigger, SplitText);
const hero = document.getElementById("hero");

gsap.to(hero, {
  scale: 0.4,          // 1 - 0.6
  ease: "none",
  scrollTrigger: {
    trigger: hero,
    start: "top top",
    end: "50% top",    // same as window.innerHeight * 0.5
    scrub: 0.8
  }
});

  // Split the text
  let split = SplitText.create(".about-content", {type:"words,lines"});

  // Animate each line (we can use each sentence as a line)
  gsap.from(split.lines, {
    y: 50,
    opacity: 0,
    duration: 0.8,
    ease: "power3.out",
    stagger: 0.3,
    scrollTrigger: {
      trigger: "#about",
      start: "top 80%",
      toggleActions: "play none none none"
    }
  });

  // Optional: refresh on resize
  window.addEventListener("resize", () => split.revert());

// Blog post hero-image cursor
if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
  const cursor = document.querySelector(".writing-cursor");
  const items = document.querySelectorAll(".writing-item[data-hero]");

  if (cursor && items.length) {
    gsap.set(cursor, { xPercent: -50, yPercent: -50, scale: 0.8, opacity: 0 });

    const moveX = gsap.quickTo(cursor, "x", { duration: 0.55, ease: "power3" });
    const moveY = gsap.quickTo(cursor, "y", { duration: 0.55, ease: "power3" });

    window.addEventListener("pointermove", (event) => {
      moveX(event.clientX);
      moveY(event.clientY);
    });

    let visible = false;

    items.forEach((item) => {
      item.addEventListener("pointerenter", () => {
        cursor.style.backgroundImage = `url("${item.dataset.hero}")`;
        if (visible) return;
        visible = true;
        gsap.to(cursor, {
          opacity: 1,
          scale: 1,
          duration: 0.35,
          ease: "power3.out",
        });
      });

      item.addEventListener("pointerleave", () => {
        if (!visible) return;
        visible = false;
        gsap.to(cursor, {
          opacity: 0,
          scale: 0.8,
          duration: 0.25,
          ease: "power2.out",
        });
      });
    });
  }
}

// the skills section
document.addEventListener("DOMContentLoaded", () => {
  const categories = document.querySelectorAll(".skill-category");

  categories.forEach((cat) => {
    const content = cat.querySelector(".skill-content");
    const icon = cat.querySelector(".icon");

    // Initial state
    if (cat.classList.contains("active")) {
      gsap.set(content, { height: "auto" });
      gsap.set(icon, { rotate: 45 });
    } else {
      gsap.set(content, { height: 0 });
    }

    cat.addEventListener("click", () => {
      const isActive = cat.classList.contains("active");

      // Close all
      categories.forEach((c) => {
        c.classList.remove("active");

        gsap.to(c.querySelector(".skill-content"), {
          height: 0,
          duration: 0.4,
          ease: "power2.inOut"
        });

        gsap.to(c.querySelector(".icon"), {
          rotate: 0,
          duration: 0.3
        });
      });

      // Open clicked
      if (!isActive) {
        cat.classList.add("active");

        gsap.to(content, {
          height: "auto",
          duration: 0.5,
          ease: "power3.out"
        });

        gsap.from(content.children, {
          opacity: 0,
          y: 20,
          stagger: 0.1,
          duration: 0.4
        });

        gsap.to(icon, {
          rotate: 45,
          duration: 0.3
        });
      }
    });
  });
});
</script>

