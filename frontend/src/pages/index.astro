---
import BaseHead from '../components/BaseHead.astro';
import FundekaMockup from '../assets/fundeka_mock.png';
import ProfileReveal from '../components/Profilereveal.astro';
import { Image } from 'astro:assets';
import ZimbabweADR from '../assets/zimbabwe_adr.svg';
import PharmacokineticPAR from '../assets/pharmacokinetic_par.svg'; 
import Header from '../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/design.css';
---
<script>
	const hero = document.getElementById("hero");
	window.addEventListener("scroll", () => {
		const scrollY = window.scrollY;
		const maxScroll = window.innerHeight * 0.5;
		const progress = Math.min(scrollY / maxScroll, 1);
		const scale = 1 - progress * 0.6;
		const translateY = progress * -100;

		hero.style.transform = 
			`scale(${scale}) translateY(${translateY}px)`;
	});
</script>

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header/>
		<main>
			<div class="hero-and-transition">
				<section id="hero" class="hero-section section">
					<div class="hero-name">
						<span class="hero-name-first">MUNYARADZI</span>
						<span class="hero-name-last">CHIWUNDURA</span>
					</div>


					<div class="hero-hello">HELLO</div>
					
					<div class="hero-tagline">
						- intelligent, data-driven tools
					</div>

					<div class="hero-role">
						Pharmaceutical Data Scientist
					</div>

					<a href="/resume.pdf" class="hero-resume-btn">Download Resume</a>

					<div class="hero-profile-images">
						<ProfileReveal/>
					</div>
				</section>

				<section class="transition-section section">
					<div class="transition-text-large">
						Intelligent Data Driven Solutions for health and Education • Pharmacy and learning • 
					</div>
					<div class="transition-text-large">
						Pharmacy and learning • Intelligent Data Driven Solutions for health and Education • 
					</div>
				</section>
			</div>
				<section class="about-section section" id="about">
					<h2 class="about-title">Who Am I</h2>
					<p class="about-content">
						Pharmacist and pharmacology MSc graduate specializing in pharmaceutical data science. I build data-driven models, explore pharmacometrics, and develop software tools for drug research. Passionate about translating clinical and biological data into actionable insights that improve.
					</p>
				</section>

				<section class="data-projects-section section" id="projects">
					<div class="section-bg-text">Data Projects</div>
					<h2 class="section-title">Data Projects</h2>
					
					<div class="projects-grid-container">
						<div class="data-card">
							<h3>Zimbabwe ADR Surveillance System</h3>
							<p>An advanced Adverse Drug reaction Surveillance system to predict and react to ADRS in Zimbabwe before they happen.</p>
							<a href="#">Read more</a>
						</div>
						<div class="data-card">
							<h3>Pharmacokinetic Parameter Estimator</h3>
							<p>A tool designed to predict key pharmacokinetic and pharmacodynamic parameters from sparse or noisy data.</p>
							<a href="#">Read more</a>
						</div>
						<div class="data-card">
							<h3>Zimbabwe Medicine Price Analyzer</h3>
							<p>An online platform that provides accurate and up-to-date pricing information for medicines in Zimbabwe.</p>
							<a href="#">Read more</a>
						</div>
						<div class="data-card">
							<h3>Dose Optimization Via Reinforcement Learning</h3>
							<p>Applying reinforcement learning techniques to optimize medication dosing regimens for individual patients.</p>
							<a href="#">Read more</a>
						</div>
					</div>
				</section>

				<section class="skills-section section">
					<div class="section-bg-text">Skills and Expertise</div>
					<h2 class="section-title">Skills and Expertise</h2>
					<div class="skills-container">
						<div class="skill-category">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 style="font-size: 64px; font-weight: 400; margin: 0;">Biomedical & Scientific Systems</h3>
								<div style="width: 64px; height: 64px; border: 2px solid white; border-radius: 50%; display: flex; align-items: center; justify-content: center;">↗</div>
							</div>
							<p style="font-size: 24px; margin: 20px 0;">Designing structured, evidence-driven systems grounded in pharmacology and biological reasoning.</p>
							<div style="display: flex; gap: 20px; margin-top: 20px;">
								<div style="background: #B1B2B5; padding: 10px 20px; border-radius: 5px; color: black; display: flex; align-items: center; gap: 10px;">
									<div style="width: 30px; height: 30px; background: rgba(0,0,0,0.2);"></div>
									<span>Master of Science Pharmacology</span>
								</div>
								<div style="background: #B1B2B5; padding: 10px 20px; border-radius: 5px; color: black; display: flex; align-items: center; gap: 10px;">
									<div style="width: 30px; height: 30px; background: rgba(0,0,0,0.2);"></div>
									<span>Bachelor of Pharmacy</span>
								</div>
							</div>
						</div>
						<div class="skill-category" style="margin-top: 40px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 20px;">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 style="font-size: 64px; font-weight: 400; color: #000; -webkit-text-stroke: 1px white;">Software Architecture & Development</h3>
								<div style="width: 64px; height: 64px; border: 2px solid black; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: black;">↗</div>
							</div>
						</div>
						<div class="skill-category" style="margin-top: 40px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 20px;">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 style="font-size: 64px; font-weight: 400; color: #000; -webkit-text-stroke: 1px white;">Quantitative Modeling & Algorithms</h3>
								<div style="width: 64px; height: 64px; border: 2px solid black; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: black;">↗</div>
							</div>
						</div>
						<div class="skill-category" style="margin-top: 40px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 20px;">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<h3 style="font-size: 64px; font-weight: 400; color: #000; -webkit-text-stroke: 1px white;">Design, Interaction & Creative Systems</h3>
								<div style="width: 64px; height: 64px; border: 2px solid black; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: black;">↗</div>
							</div>
						</div>
					</div>
				</section>

				<section class="fundeka-section section">
					<div class="fundeka-content">
						<span style="text-transform: uppercase; font-weight: 700;">Current Work</span>
						<h2 class="fundeka-title">Fundeka</h2>
						<p style="font-size: 24px; max-width: 610px; margin: 20px 0;">
							An AI-powered learning platform for Mathematics, Physics, and Life Sciences across DBE, ZIMSEC, Cambridge, and IEB. It blends spaced-repetition flashcards and Pomodoro focus with adaptive AI study timetables that adjust to your understanding.
						</p>
						<div style="display: flex; gap: 20px; margin-top: 30px;">
							<a href="#" class="button-primary" style="background: #9584FF; padding: 10px 40px; border-radius: 24px; color: white; text-decoration: none;">Open App</a>
							<a href="#" class="button-secondary" style="background: #B1B2B5; padding: 10px 40px; border-radius: 24px; color: black; text-decoration: none;">Source Code</a>
						</div>
					</div>
					<div style="position: absolute; left: -16px; top: 103px; width: 691px; height: 616px;">
						<Image src={FundekaMockup} alt="Fundeka Mockup" style="width: 100%; height: 100%; object-fit: cover;" />
					</div>
				</section>

				<section class="writing-section section">
					<div class="section-bg-text">Writing</div>
					<h2 class="section-title">Writing</h2>
					
					<div class="writing-item">
						<div>
							<span style="color: rgba(0,0,0,0.6);">Feb 2026</span>
							<h3>Why Most Health Tech Fails in Low Resource Settings</h3>
						</div>
						<span style="color: rgba(0,0,0,0.6);">DIGITAL HEALTH</span>
					</div>
					<div class="writing-item">
						<div>
							<span style="color: rgba(0,0,0,0.6);">Feb 2026</span>
							<h3>Efficient by design: Rust and Healthcare Software in Africa</h3>
						</div>
						<span style="color: rgba(0,0,0,0.6);">DIGITAL HEALTH</span>
					</div>
					<div class="writing-item">
						<div>
							<span style="color: rgba(0,0,0,0.6);">Feb 2026</span>
							<h3>What Makes Clinical AI Harder Than Other AI Problems</h3>
						</div>
						<span style="color: rgba(0,0,0,0.6);">CLINICAL AI</span>
					</div>
				</section>

				<section class="contact-section section">
					<div class="contact-badge">
						<div class="status-dot"></div>
						<span>AVAILABLE FOR A NEW PROJECT</span>
					</div>
					<h2 style="font-size: 72px; font-weight: 400; margin-bottom: 20px;">HAVE A PROJECT IN MIND?</h2>
					<p style="font-size: 36px; font-weight: 300; max-width: 1040px; margin-bottom: 50px;">
						Together, we can create something clear and impactful. Let's collaborate to bring our ideas to life in a way that resonates with everyone
					</p>
					
					<a href="mailto:your-email" style="background: #000000; color: white; padding: 15px 50px; border-radius: 32px; text-decoration: none; font-size: 24px; margin-bottom: 60px;">Contact me</a>
					
					<div style="display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;">
						<a href="#" style="background: white; border: 1px solid rgba(0,0,0,0.2); padding: 10px 30px; border-radius: 32px; color: black; text-decoration: none;">Instagram</a>
						<a href="#" style="background: white; border: 1px solid rgba(0,0,0,0.2); padding: 10px 30px; border-radius: 32px; color: black; text-decoration: none;">Dribbble</a>
						<a href="#" style="background: white; border: 1px solid rgba(0,0,0,0.2); padding: 10px 30px; border-radius: 32px; color: black; text-decoration: none;">Linkedin</a>
						<a href="#" style="background: white; border: 1px solid rgba(0,0,0,0.2); padding: 10px 30px; border-radius: 32px; color: black; text-decoration: none;">Github</a>
						<a href="#" style="background: white; border: 1px solid rgba(0,0,0,0.2); padding: 10px 30px; border-radius: 32px; color: black; text-decoration: none;">Twitter</a>
					</div>
				</section>
		</main>
	</body>
</html>
